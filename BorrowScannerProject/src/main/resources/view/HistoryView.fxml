<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="be.esi.prj.controller.HistoryController">

    <!-- HEADER -->
    <top>
        <VBox spacing="20" alignment="CENTER" styleClass="header">

            <Label text="Historique des transactions"
                   styleClass="title"/>

            <!-- NAVIGATION -->
            <HBox spacing="20" alignment="CENTER" styleClass="nav-bar">

                <Button fx:id="dashboardButton" text="🏠 Dashboard" styleClass="nav-button"/>
                <Button fx:id="inventoryButton" text="🛠️ Inventaire" styleClass="nav-button"/>
                <Button fx:id="usersButton" text="👤 Utilisateurs" styleClass="nav-button"/>
                <Button text="📜 Historique" disable="true" styleClass="nav-button"/>

            </HBox>

            <Separator/>
        </VBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>

        <VBox spacing="20" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="main-container">

            <!-- BARRE DE FILTRES -->
            <HBox spacing="10" alignment="CENTER" styleClass="filter-bar">

                <TextField fx:id="searchLogField" promptText="Rechercher (matériel, utilisateur...)"
                           prefWidth="250" styleClass="text-field"/>

                <ComboBox fx:id="filterAction" promptText="Action" styleClass="combo-box"/>
                <ComboBox fx:id="sortDate" promptText="Trier par date" styleClass="combo-box"/>

                <DatePicker fx:id="startDatePicker" promptText="Début" prefWidth="150" styleClass="date-picker"/>
                <DatePicker fx:id="endDatePicker" promptText="Fin" prefWidth="150" styleClass="date-picker"/>

            </HBox>

            <!-- TABLE -->
            <TableView fx:id="logTable" maxWidth="920" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colLoanId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colItem" text="Matériel" prefWidth="120"/>
                    <TableColumn fx:id="colBorrower" text="Utilisateur" prefWidth="120"/>
                    <TableColumn fx:id="colBorrowDate" text="Prêt" prefWidth="150"/>
                    <TableColumn fx:id="colDueDate" text="Échéance" prefWidth="150"/>
                    <TableColumn fx:id="colReturnDate" text="Retour" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="150"/>
                </columns>
            </TableView>

        </VBox>
    </center>
</BorderPane>