<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="be.esi.prj.controller.InventoryController">

    <!-- HEADER -->
    <top>
        <VBox spacing="20" alignment="CENTER" styleClass="header">

            <Label text="Gestion de l'inventaire" styleClass="title"/>

            <!-- NAVIGATION -->
            <HBox spacing="15" alignment="CENTER" styleClass="nav-bar">
                <Button fx:id="dashboardButton" text="🏠 Dashboard" styleClass="nav-button"/>
                <Button text="🛠️ Inventaire" disable="true" styleClass="nav-button"/>
                <Button fx:id="usersButton" text="👤 Utilisateurs" styleClass="nav-button"/>
                <Button fx:id="historyButton" text="📜 Historique" styleClass="nav-button"/>
            </HBox>

            <Separator/>

        </VBox>
    </top>

    <!-- CONTENU -->
    <center>

        <VBox spacing="20" styleClass="main-container" alignment="CENTER">

            <!-- TOOLBAR -->
            <HBox spacing="10" alignment="CENTER" styleClass="filter-bar">

                <TextField fx:id="searchItemField" promptText="Rechercher un matériel..."
                           prefWidth="250" styleClass="text-field"/>

                <ComboBox fx:id="filterCategory" promptText="CATÉGORIE" styleClass="combo-box"/>
                <ComboBox fx:id="filterStatus" promptText="STATUT" styleClass="combo-box"/>

                <Button fx:id="addButton" text="➕ Ajouter" styleClass="button"/>
                <Button fx:id="editButton" text="✏️ Modifier" styleClass="button"/>
                <Button fx:id="deleteButton" text="🗑 Supprimer" styleClass="button danger"/>

            </HBox>

            <!-- TABLE -->
            <TableView fx:id="itemTable" maxWidth="800" VBox.vgrow="ALWAYS" styleClass="table-view">

                <placeholder>
                    <Label text="Aucun matériel trouvé"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colQrId" text="QR_ID" prefWidth="120"/>
                    <TableColumn fx:id="colName" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colCategory" text="Catégorie" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="150"/>
                    <TableColumn fx:id="colQrPath" text="QR_Path" prefWidth="230"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>