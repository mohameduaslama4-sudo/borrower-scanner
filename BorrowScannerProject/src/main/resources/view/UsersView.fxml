<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="be.esi.prj.controller.UsersController">

    <!-- HEADER -->
    <top>
        <VBox spacing="20" alignment="CENTER" styleClass="header">

            <Label text="Gestion des utilisateurs" styleClass="title"/>

            <!-- NAVIGATION -->
            <HBox spacing="20" alignment="CENTER" styleClass="nav-bar">

                <Button fx:id="dashboardButton" text="🏠 Dashboard" styleClass="nav-button"/>
                <Button fx:id="inventoryButton" text="🛠️ Inventaire" styleClass="nav-button"/>
                <Button text="👤 Utilisateurs" disable="true" styleClass="nav-button"/>
                <Button fx:id="historyButton" text="📜 Historique" styleClass="nav-button"/>

            </HBox>

            <Separator/>
        </VBox>
    </top>

    <!-- CONTENU -->
    <center>

        <SplitPane fx:id="splitPane" dividerPositions="0.65" styleClass="split-pane">

            <items>

                <!-- LEFT PANEL -->
                <VBox spacing="10" styleClass="main-container" alignment="CENTER">

                    <!-- SEARCH + ADD -->
                    <HBox spacing="10" styleClass="filter-bar">

                        <TextField fx:id="searchUserField" promptText="Rechercher un utilisateur..."
                                   HBox.hgrow="ALWAYS" styleClass="text-field"/>

                        <Button fx:id="addUserButton" text="➕" styleClass="button"/>

                    </HBox>

                    <!-- TABLE -->
                    <TableView fx:id="userTable" maxWidth="600" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                            <TableColumn fx:id="colLastName" text="Nom" prefWidth="150"/>
                            <TableColumn fx:id="colFirstName" text="Prénom" prefWidth="150"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <!-- FORM -->
                    <VBox fx:id="addUserForm" spacing="20" visible="false" managed="false" styleClass="form-box">

                        <Label text="Formulaire d'inscription" styleClass="subtitle"/>

                        <TextField fx:id="newLastName" promptText="Nom" styleClass="text-field"/>
                        <TextField fx:id="newFirstName" promptText="Prénom" styleClass="text-field"/>
                        <TextField fx:id="newEmail" promptText="Email" styleClass="text-field"/>

                        <HBox spacing="10">
                            <Button fx:id="cancelAddButton" text="Annuler" styleClass="button"/>
                            <Button fx:id="confirmAddButton" text="Ajouter" styleClass="button success"/>
                        </HBox>

                    </VBox>

                </VBox>

                <!-- RIGHT PANEL -->
                <VBox fx:id="rightPane" alignment="CENTER" spacing="10" visible="false" managed="false" styleClass="detail-panel">

                    <GridPane hgap="10" vgap="10">

                        <Label text="INFORMATIONS UTILISATEUR" GridPane.rowIndex="1" GridPane.columnIndex="2"
                               GridPane.columnSpan="3" GridPane.halignment="CENTER" underline="true" styleClass="subtitle"/>

                        <!-- Nom -->
                        <Label text="Nom :" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label fx:id="detailLastNameLabel" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

                        <!-- Prénom -->
                        <Label text="Prénom :" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label fx:id="detailFirstNameLabel" GridPane.rowIndex="4" GridPane.columnIndex="2"/>

                        <!-- Email -->
                        <Label text="Email :" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <Label fx:id="detailEmailLabel" GridPane.rowIndex="5" GridPane.columnIndex="2"/>

                        <Button fx:id="updateEmailButton" text="✏ Modifier email" styleClass="button"
                                GridPane.rowIndex="7" GridPane.columnIndex="2"/>

                    </GridPane>


                    <Separator/>

                    <Label fx:id="currentLoansCountLabel" text="Emprunts en cours : 0" styleClass="subtitle"/>

                    <ListView fx:id="currentLoansList" prefHeight="150" styleClass="list-view">
                        <placeholder>
                            <Label text="Aucun emprunt en cours"/>
                        </placeholder>
                    </ListView>

                    <Separator/>

                    <Label text="Historique récent" styleClass="subtitle"/>

                    <ListView fx:id="recentHistoryList" prefHeight="150" styleClass="list-view">
                        <placeholder>
                            <Label text="Aucune transaction récente"/>
                        </placeholder>
                    </ListView>

                    <Separator/>

                    <Button fx:id="deleteUserButton" text="🗑 Supprimer" styleClass="button danger"/>

                </VBox>

            </items>
        </SplitPane>

    </center>
</BorderPane>