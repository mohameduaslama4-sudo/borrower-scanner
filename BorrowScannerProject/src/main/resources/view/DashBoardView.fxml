<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="be.esi.prj.controller.DashBoardController">

    <!-- HEADER -->
    <top>

        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Label text="Tableau de bord">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <!-- Navigation -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="🏠 Dashboard" disable="true"/>
                <Button fx:id="inventoryButton" text="🛠️ Inventaire" />
                <Button fx:id="usersButton" text="👤 Utilisateurs" />
                <Button fx:id="historyButton" text="📜 Historique" />
            </HBox>

            <Separator/>

        </VBox>
    </top>

    <!-- CONTENU PRINCIPALE-->
    <center>

        <VBox spacing="25" alignment="CENTER" style="-fx-padding: 20;">

            <!-- SCAN QR avec TextField non-visible -->
            <VBox spacing="10" alignment="CENTER">

                <Label text="Scanner un matériel"
                       style="-fx-font-weight: bold;"/>

                <Button fx:id="scanButton" text="📷 Scanner QR"
                        prefWidth="200"/>

                <TextField fx:id="scanField"
                           promptText="Scan QR ici"
                           visible="false"/>
            </VBox>

            <Separator/>

            <!-- STATS PERTINENTES -->
            <HBox spacing="30" alignment="CENTER">

                <VBox style="-fx-background-color: #fff3e0; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Emprunts en cours"/>
                    <Label fx:id="borrowedLabel" text="0"
                           style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: #ffebee; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Emprunts en retard"/>
                    <Label fx:id="lateLabel" text="0"
                           style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: #e3f2fd; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Empruntés aujourd’hui"/>
                    <Label fx:id="todayBorrowLabel" text="0"
                           style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: #e8f5e9; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Remis aujourd’hui"/>
                    <Label fx:id="todayReturnLabel" text="0"
                           style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>

            </HBox>

            <Separator/>

            <!-- mini-form d'ajout rapide d'item -->
            <GridPane hgap="10" vgap="10" alignment="CENTER">

                <Label text="Ajout rapide de matériel"
                       GridPane.columnSpan="2"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="quickItemName"
                           promptText="Nom du matériel"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                <ComboBox fx:id="quickItemCategory"
                          promptText="Catégorie"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Button fx:id="quickAddButton"
                        text="Ajouter"
                        GridPane.rowIndex="2"
                        GridPane.columnSpan="2"
                        maxWidth="Infinity"/>
            </GridPane>

        </VBox>
    </center>
</BorderPane>